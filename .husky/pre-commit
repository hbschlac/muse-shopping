#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Block private keys and tokens before they reach this public repo.
node scripts/scan-secrets.js --staged || exit 1

# Run tests before commit
echo "Running pre-commit tests..."

# Backend tests
echo "Testing backend..."
npm run test || exit 1

# Frontend tests  
echo "Testing frontend..."
cd frontend && npm run test || exit 1
cd ..

echo "✅ All tests passed!"
